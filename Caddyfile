{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	root * /usr/share/caddy

	encode zstd gzip

	# Allow /services as well as /services.html
	try_files {path} {path}.html {path}/index.html

	file_server

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Fingerprint-free assets: cache for a day, revalidate after
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=86400, must-revalidate"

	# Pages (including extensionless URLs): short cache so edits go live fast
	@pages not path /assets/*
	header @pages Cache-Control "public, max-age=300, must-revalidate"

	handle_errors {
		rewrite * /404.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
